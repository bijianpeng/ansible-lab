# Managed by Ansible (ansible-lab)
port {{ redis_sentinel_port }}
daemonize no
sentinel monitor {{ redis_master_name }} {{ groups['redis-master'] | first }} {{ redis_port }} {{ redis_sentinel_quorum }}
sentinel auth-pass {{ redis_master_name }} {{ redis_requirepass }}
sentinel down-after-milliseconds {{ redis_master_name }} 3000
sentinel failover-timeout {{ redis_master_name }} 180000
sentinel parallel-syncs {{ redis_master_name }} 1
